
/* central viewport */

QFrame#centralViewport {
    background-color: {{central}};
    border: 1px solid {{border}};
    border-radius: {{radius}};
}

/* panel window */

QFrame#panelSlot {
    background-color: {{base}};
    border: 1px solid {{border}};
    border-radius: {{radius}};
}

/* panel header strip */

QFrame#panelHeader {
    background-color: {{header}};
    border-bottom: 1px solid {{border}};
    border-top-left-radius: {{radius}};
    border-top-right-radius: {{radius}};
}

QFrame#panelHeader QLabel {
    font-weight: bold;
    color: {{text}};
}

QToolButton#panelCloseButton {
    border: none;
    background: transparent;
    border-radius: {{smallRadius}};
    padding: 2px 6px;
    color: {{placeholderText}};
}

QToolButton#panelCloseButton:hover {
    background-color: {{midlight}};
    color: {{text}};
}

QToolButton#panelCloseButton:pressed {
    background-color: {{mid}};
}

/* Resize handles: invisible gaps, accent on hover. */
QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:hover {
    background-color: {{highlight}};
}

/* base buttons */

QPushButton {
    background-color: {{button}};
    border: 1px solid {{border}};
    border-radius: {{smallRadius}};
    padding: 5px 14px;
    color: {{buttonText}};
}

QPushButton:hover {
    background-color: {{midlight}};
    border-color: {{mid}};
}

QPushButton:pressed {
    background-color: {{mid}};
}

QPushButton:checked {
    background-color: {{highlight}};
    color: {{highlightedText}};
    border-color: {{highlight}};
}

QPushButton:checked:hover {
    background-color: {{highlightHover}};
    border-color: {{highlightHover}};
}

QPushButton:checked:pressed {
    background-color: {{highlightPressed}};
    border-color: {{highlightPressed}};
}

QPushButton:focus {
    border-color: {{highlight}};
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: {{smallRadius}};
    padding: 3px;
}

QToolButton:hover {
    background-color: {{midlight}};
    border-color: {{border}};
}

QToolButton:pressed {
    background-color: {{mid}};
}

/* inputs */

QSpinBox,
QDoubleSpinBox {
    background-color: {{base}};
    border: 1px solid {{border}};
    border-radius: {{smallRadius}};
    padding: 3px 6px;
    color: {{text}};
    selection-background-color: {{highlight}};
    selection-color: {{highlightedText}};
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: {{highlight}};
}

/* slim scrollbars */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: {{mid}};
    border-radius: 4px;
    min-height: 24px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: {{dark}};
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: transparent;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: {{mid}};
    border-radius: 4px;
    min-width: 24px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: {{dark}};
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: transparent;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* tooltips */

QToolTip {
    background-color: {{base}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: {{smallRadius}};
    padding: 4px 8px;
}

/* frameless window title bar (menu + window controls) */

QWidget#windowTitleBar {
    background-color: {{window}};
    border-bottom: 1px solid {{border}};
}

QMenuBar {
    background: transparent;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    border-radius: {{smallRadius}};
}

QMenuBar::item:selected {
    background-color: {{midlight}};
}

QToolButton#windowButton {
    background: transparent;
    border: none;
    border-radius: {{smallRadius}};
    padding: 0;
    margin: 3px;
}

QToolButton#windowButton:hover {
    background-color: {{midlight}};
}

QToolButton#windowButton:pressed {
    background-color: {{mid}};
}

QToolButton#windowButton[close="true"]:hover {
    background-color: {{dangerHover}};
}

QToolButton#windowButton[close="true"]:pressed {
    background-color: {{dangerPressed}};
}

/* dropdown menus */

QMenu {
    background-color: {{base}};
    border: 1px solid {{border}};
    border-radius: {{radius}};
    padding: 0;
}

QMenu::item {
    padding: 7px 26px 7px 32px;
    border-radius: {{smallRadius}};
}

QMenu::item:selected {
    background-color: {{highlight}};
    color: {{highlightedText}};
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    left: 11px;
}
