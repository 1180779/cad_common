<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/cad_common/styles">
        <file alias="style.qss">style.qss</file>
    </qresource>
    <qresource prefix="/cad_common/icons">
        <file alias="window-close.svg">icons/window-close.svg</file>
        <file alias="window-minimize.svg">icons/window-minimize.svg</file>
        <file alias="window-maximize.svg">icons/window-maximize.svg</file>
        <file alias="window-restore.svg">icons/window-restore.svg</file>
    </qresource>
    <qresource prefix="/cad_common/fonts">
        <file alias="JetBrainsMono-Regular.ttf">fonts/JetBrainsMono-Regular.ttf</file>
        <file alias="JetBrainsMono-Bold.ttf">fonts/JetBrainsMono-Bold.ttf</file>
    </qresource>
</RCC>
